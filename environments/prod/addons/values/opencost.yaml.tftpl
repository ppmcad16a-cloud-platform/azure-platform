opencost:
  exporter:
    defaultClusterId: ${cluster}
    # Image from our ACR (ghcr.io pulls stall in Azure Central India).
    image:
      registry: acrmern0botwx.azurecr.io
  # Read CPU/memory usage from our Prometheus.
  prometheus:
    internal:
      enabled: true
      namespaceName: monitoring
      serviceName: kps-prometheus
      port: 9090
  # Let Prometheus collect OpenCost's own cost metrics (for Grafana).
  metrics:
    serviceMonitor:
      enabled: true
  ui:
    enabled: true
    image:
      registry: acrmern0botwx.azurecr.io
